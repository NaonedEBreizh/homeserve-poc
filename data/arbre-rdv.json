        "note": "souscription par téléphone"
      },
      "cta_secondaire": "transmettre_proprietaire"
    },
    "@S4a": {
      "code": "S4a",
      "titre": "Nous prenons le relais pour votre dépannage",
      "offre": {
        "libelle": "Dépannage et entretien",
        "url": "https://www.homeserve.fr/depannage-entretien",
        "en_ligne": false
      }
    },
    "@S4b": {
      "code": "S4b",
      "titre": "Planifions l'entretien de votre installation",
      "offre": {
        "libelle": "Dépannage et entretien",
        "url": "https://www.homeserve.fr/depannage-entretien",
        "en_ligne": false
      }
    },
    "@S4c": {
      "code": "S4c",
      "titre": "Un diagnostic pour votre installation existante",
